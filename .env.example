# ──────────────────────────────────────────────────────────
# Variáveis de Ambiente — Cooperativa Plataforma
# Copie para .env e preencha os valores
# NUNCA comite .env no repositório
# ──────────────────────────────────────────────────────────

# ── Contratos (gerado pelo script de deploy) ───────────────
IDENTITY_CONTRACT_ADDRESS=

# ── Polygon RPC ────────────────────────────────────────────
# Mainnet: https://polygon-rpc.com (gratuito, sem API key)
# Amoy testnet: https://rpc-amoy.polygon.technology
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology

# ── Cloudflare Worker (gerado pelo wrangler deploy) ────────
SIGNALING_SERVER_URL=https://cooperativa-signaling.SEU_SUBDOMINIO.workers.dev

# ── Deploy dos contratos (não expor no app mobile!) ────────
DEPLOYER_PRIVATE_KEY=
POLYGONSCAN_API_KEY=

# ── Cloudflare ─────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=
